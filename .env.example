# AeroAssist AI - Environment Configuration Template
# Copy this file to .env and fill in with your actual values

# ============================================================================
# APP CONFIGURATION
# ============================================================================
APP_NAME=AeroAssist AI
APP_VERSION=1.0.0
APP_PACKAGE=io.aeroassist.ai

# ============================================================================
# ENVIRONMENT
# ============================================================================
# Options: development, staging, production
ENVIRONMENT=development

# ============================================================================
# DEBUG & LOGGING
# ============================================================================
DEBUG_MODE=true
LOG_LEVEL=debug
# Options: verbose, debug, info, warning, error

# ============================================================================
# DATABASE
# ============================================================================
# SQLite database file name
DATABASE_NAME=aeroassist_ai.db

# Enable database encryption
DATABASE_ENCRYPTION=false

# ============================================================================
# AI & CHAT CONFIGURATION
# ============================================================================
# Maximum maintenance procedures to load into memory
MAX_PROCEDURES_CACHE=50

# Chat response cache timeout (minutes)
CHAT_CACHE_TTL=60

# ============================================================================
# CAMERA & VISION
# ============================================================================
# Camera resolution: low, medium, high, veryHigh, ultraHigh, max
CAMERA_RESOLUTION=medium

# Enable camera preview
CAMERA_PREVIEW_ENABLED=true

# Object detection confidence threshold (0.0 - 1.0)
DETECTION_CONFIDENCE_THRESHOLD=0.7

# ============================================================================
# FIREBASE CONFIGURATION (Optional - for cloud sync only)
# ============================================================================
# Leave empty if using offline-only mode

# Firebase Project Settings
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Enable Firebase features (true/false)
FIREBASE_ENABLED=false
FIREBASE_ANALYTICS_ENABLED=false
FIREBASE_CRASH_REPORTING_ENABLED=false

# ============================================================================
# API ENDPOINTS (Optional)
# ============================================================================
# Leave empty if using fully offline mode

# Main API base URL
MAIN_API_URL=

# WebSocket URL for real-time data
WEBSOCKET_URL=

# API timeout (seconds)
API_TIMEOUT=30

# ============================================================================
# STORAGE PATHS
# ============================================================================
# Relative paths for app storage
STORAGE_PROCEDURES_PATH=assets/data/maintenance_procedures.json
STORAGE_SPECS_PATH=assets/data/torque_specs.json
STORAGE_IMAGES_PATH=app_images/
STORAGE_REPORTS_PATH=app_reports/

# Maximum image storage size (MB)
MAX_IMAGE_STORAGE=500

# ============================================================================
# SECURITY
# ============================================================================
# Enable PIN/Biometric lock
BIOMETRIC_ENABLED=false

# Session timeout (minutes)
SESSION_TIMEOUT=30

# ============================================================================
# FEATURES
# ============================================================================
# Enable/disable individual features

# Visual Lock (Camera Verification)
FEATURE_VISUAL_LOCK=true

# AI Chatbot
FEATURE_CHATBOT=true

# Smart Manual
FEATURE_SMART_MANUAL=true

# Auto Documentation
FEATURE_AUTO_DOCUMENTATION=true

# Maintenance History
FEATURE_MAINTENANCE_HISTORY=true

# Voice Support
FEATURE_VOICE_SUPPORT=true

# Multi-language Support
FEATURE_MULTILINGUAL=false

# Cloud Sync
FEATURE_CLOUD_SYNC=false

# ============================================================================
# LANGUAGE & LOCALIZATION
# ============================================================================
# Default language: en, es, hi, ta, etc.
DEFAULT_LANGUAGE=en

# Enable offline translation (requires models)
OFFLINE_TRANSLATION_ENABLED=false

# ============================================================================
# ANALYTICS & MONITORING
# ============================================================================
# Enable usage analytics
ANALYTICS_ENABLED=false

# Enable performance monitoring
PERFORMANCE_MONITORING_ENABLED=false

# Enable crash reporting
CRASH_REPORTING_ENABLED=false

# ============================================================================
# NOTIFICATIONS
# ============================================================================
# Enable local notifications
NOTIFICATIONS_ENABLED=true

# Enable push notifications (if cloud sync enabled)
PUSH_NOTIFICATIONS_ENABLED=false

# ============================================================================
# TESTING
# ============================================================================
# Use mock data for testing
TESTING_MODE=false

# Enable demo procedures
DEMO_MODE=false

# Simulate camera verification (for testing without camera)
MOCK_CAMERA_ENABLED=false

# ============================================================================
# THIRD-PARTY SERVICES
# ============================================================================
# Google Play Services enabled
GOOGLE_PLAY_SERVICES=true

# Apple App Tracking enabled
APPLE_APP_TRACKING=true

# ============================================================================
# NOTES
# ============================================================================
# 1. Copy this file to .env in project root
# 2. Update values as needed for your environment
# 3. Never commit .env file to version control
# 4. Use .env.example for version control
# 5. Keep sensitive data (keys, passwords) secure
# 6. Use environment variables for CI/CD deployments
